<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_hint"
            android:textAppearance="?attr/textAppearanceCaption" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:background="#000000"
            android:contentDescription="@string/preview_hint"
            android:minHeight="120dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/drive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2" />

        <Button
            android:id="@+id/grantLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_grant_location" />

        <Button
            android:id="@+id/backgroundLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_background_location" />

        <Button
            android:id="@+id/refresh"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_refresh" />

        <Button
            android:id="@+id/simulate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_simulate" />

        <Button
            android:id="@+id/testAlert"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_alert" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_voice" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/headingUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_heading_up" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/kmh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_kmh" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/carMapOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_car_map_overlay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_car_map_overlay"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_alert_distance"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <RadioGroup
            android:id="@+id/distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/dist02"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.2 mi" />

            <RadioButton
                android:id="@+id/dist03"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.3 mi" />

            <RadioButton
                android:id="@+id/dist05"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.5 mi" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_map_style"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <RadioGroup
            android:id="@+id/style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/styleAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_auto" />

            <RadioButton
                android:id="@+id/styleLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_light" />

            <RadioButton
                android:id="@+id/styleDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_dark" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/attribution"
            android:textAppearance="?attr/textAppearanceCaption" />
    </LinearLayout>
</ScrollView>
